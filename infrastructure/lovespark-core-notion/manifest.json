{
  "manifest_version": 3,
  "name": "LoveSpark Core",
  "version": "0.1.0",
  "description": "Retro pink productivity suite for neurodivergent minds 💕",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/browser-polyfill.min.js",
        "core/state.js",
        "modules/cursor-pack/themes.js",
        "modules/cursor-pack/index.js",
        "core/rules.js",
        "core/runtime.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "dashboard/options.html",
  "action": {
    "default_popup": "dashboard/options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "core@lovespark.suite",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data."
      }
    }
  }
}
