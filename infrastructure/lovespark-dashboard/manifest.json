{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.31",
  "description": "__MSG_extDescription__",
  "permissions": [
    "management",
    "tabs"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Open LoveSpark Dashboard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dashboard@lovespark.suite",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data."
      }
    }
  },
  "default_locale": "en"
}
