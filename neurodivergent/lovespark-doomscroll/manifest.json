{
  "manifest_version": 3,
  "name": "Pink Anti-Doomscroll",
  "version": "0.1.0",
  "description": "Gentle doomscroll awareness for Twitter/X and Reddit — pink tint, whisper nudges, and sparkles 🌸",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*"
      ],
      "css": ["styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*"
      ],
      "js": ["lib/browser-polyfill.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["media/mascot.png"],
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.reddit.com/*"]
    }
  ]
}
