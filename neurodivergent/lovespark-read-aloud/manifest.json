{
  "manifest_version": 3,
  "name": "LoveSpark Read Aloud",
  "version": "1.0.34",
  "description": "Free text-to-speech for any webpage. Sentence highlighting, ADHD speed presets, reading position memory. No tracking, always free.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or pause reading"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/highlighter.css",
        "mascot.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "read-aloud@lovespark.suite",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data. All text-to-speech processing uses the browser's built-in Web Speech API locally."
      }
    }
  }
}