{
  "expo": {
    "name": "LoveSpark Notes",
    "slug": "lovespark-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lovespark-notes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDCFE1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lovespark.notes"
    },
    "android": {
      "package": "com.lovespark.notes",
      "adaptiveIcon": {
        "backgroundColor": "#FDCFE1",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing"
    ]
  }
}
