{
  "manifest_version": 3,
  "name": "LoveSpark Panic Button",
  "version": "1.0.2",
  "homepage_url": "https://lovespark.love",
  "description": "One click to escape to a calm safe space when overwhelmed. Breathing and grounding for ADHD. Free, private.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "permissions": [
    "storage"
  ],
  "commands": {
    "panic": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open panic button safe space"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "panic-button@lovespark.suite",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data. All data stays in local browser storage."
      }
    }
  }
}