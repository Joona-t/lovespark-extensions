{
  "manifest_version": 3,
  "name": "LoveSpark Auto TOC",
  "version": "1.0.2",
  "homepage_url": "https://lovespark.love",
  "description": "Auto-generate a table of contents sidebar from any article headings. ADHD reading aid. Free, no tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-toc@lovespark.suite",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data. All settings stay in local browser storage."
      }
    }
  }
}