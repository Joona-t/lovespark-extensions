{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.3",
  "description": "__MSG_extDescription__",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "css": [
        "filters/base-filter.css",
        "filters/overrides.css"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "filters/youtube.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.google.com/*"
      ],
      "css": [
        "filters/google.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "css": [
        "filters/reddit.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://x.com/*"
      ],
      "css": [
        "filters/twitter.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://github.com/*"
      ],
      "css": [
        "filters/github.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@lovespark.suite",
      "data_collection_permissions": {
        "is_exempt": true,
        "justification": "This extension does not collect, transmit, or store any user data."
      }
    }
  },
  "default_locale": "en"
}
